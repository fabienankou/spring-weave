# Configuration pour Docker-Compose
# Copier ce fichier en .env et l'adapter à votre environnement

# ========================
# BASE DE DONNÉES
# ========================
POSTGRES_USER=postgres
POSTGRES_PASSWORD=admin123
POSTGRES_DB=spring_weave
POSTGRES_VERSION=15-alpine

# ========================
# SPRING BOOT - DATASOURCE
# ========================
SPRING_DATASOURCE_URL=jdbc:postgresql://db:5432/spring_weave
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=admin123
SPRING_DATASOURCE_DRIVER_CLASS_NAME=org.postgresql.Driver

# ========================
# JPA / HIBERNATE
# ========================
SPRING_JPA_HIBERNATE_DDL_AUTO=update
SPRING_JPA_SHOW_SQL=false
SPRING_JPA_PROPERTIES_HIBERNATE_DIALECT=org.hibernate.dialect.PostgreSQLDialect
SPRING_JPA_PROPERTIES_HIBERNATE_FORMAT_SQL=false

# ========================
# JWT CONFIGURATION
# ========================
APPLICATION_SECURITY_JWT_SECRET_KEY=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
APPLICATION_SECURITY_JWT_EXPIRATION=86400000

# ========================
# PGADMIN
# ========================
PGADMIN_DEFAULT_EMAIL=admin@shopivers.com
PGADMIN_DEFAULT_PASSWORD=admin123

# ========================
# APPLICATION INFO
# ========================
APPLICATION_NAME=SHOPIVERS
APPLICATION_VERSION=1.0.0
APPLICATION_DESCRIPTION=Plateforme E-Commerce Cross-Border

# ========================
# SERVEUR
# ========================
SERVER_PORT=8080

# ========================
# LOGGING
# ========================
LOGGING_LEVEL_ROOT=INFO
LOGGING_LEVEL_COM_EXAMPLE_SPRINGWEAVE=DEBUG

# ========================
# ACTUATOR
# ========================
MANAGEMENT_ENDPOINTS_WEB_EXPOSURE_INCLUDE=health,metrics
MANAGEMENT_ENDPOINT_HEALTH_SHOW_DETAILS=always
